---
/**
 * Chapter IV — Still, and always.  (Present day)
 *
 * Two movements: the five reasons (a stacking deck) and the spotlight line.
 *
 * The reasons are the bilingual heart of the site — English headings over
 * Cebuano bodies. They are marked lang="ceb" and otherwise left completely
 * alone.
 */
import { REASONS } from '../../data/reasons.js';
---
<section class="ch four" id="chapter-iv" aria-labelledby="ch4-title" data-chapter="iv">

  <!-- Movement 1: the reasons ------------------------------------------- -->
  <div class="ch__movement four__reasons" data-reasons>
    <div class="frame">
      <header class="ch__head">
        <p class="ch__eyebrow">
          <span class="ch__numeral">IV</span>
          <span>Present day</span>
        </p>
        <h2 class="ch__title" id="ch4-title" data-split>
          Why it is always you
        </h2>
      </header>
    </div>

    <div class="four__deck-pin" data-reasons-pin>
      <ol class="four__deck" data-reasons-deck>
        {REASONS.map((r) => (
          <li class="four__card" data-reasons-card>
            <p class="four__n mono">Reason {r.n} <span aria-hidden="true">/ 05</span></p>
            <h3 class="four__title">{r.title}</h3>
            {/* Cebuano. Tagged so it is not read aloud with an English voice. */}
            <p class="four__body" lang="ceb">{r.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <!-- Movement 2: the spotlight ------------------------------------------ -->
  <div class="ch__movement four__spot" data-spotlight data-tone="dark">
    <p class="four__spot-line" data-spotlight-text>
      Even on the days I go quiet, you are still the{' '}
      <em>loudest, softest</em>{' '}thought I carry with me &mdash; everywhere I go.
    </p>
    <p class="four__spot-hint kicker" aria-hidden="true">move your light around</p>
  </div>
</section>

<style>
  .four { background: var(--bone); }

  /* --- the reasons deck ----------------------------------------------------- */
  .four__reasons { padding-top: var(--s-7); }

  .four__deck-pin {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: var(--s-6) var(--gutter);
  }

  .four__deck {
    position: relative;
    list-style: none;
    margin: 0; padding: 0;
    width: min(44rem, 92vw);
    /* The cards stack in one cell; motion/present.js deals them. */
    display: grid;
  }

  .four__card {
    grid-area: 1 / 1;
    display: grid;
    gap: var(--s-4);
    align-content: center;
    min-height: 23rem;
    padding: var(--s-7);
    background: var(--bone-warm);
    border: 1px solid var(--ink-06);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-card);
  }

  .four__n {
    font-size: 10px;
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
    color: var(--ember-text);
  }
  .four__n span { color: var(--ink-muted); }

  .four__title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: var(--w-serif);
    font-size: var(--t-lg);
    line-height: 1.12;
    max-width: 18ch;
  }

  .four__body {
    font-size: var(--t-body);
    line-height: var(--lh-loose);
    color: var(--ink-80);
    max-width: 46ch;
  }

  /* --- the spotlight ---------------------------------------------------------
     A dim line with a bright one revealed through a mask that follows the
     pointer. The dim copy is the real text and is always legible on its own;
     the spotlight is a flourish on top, not the only way to read it. */
  .four__spot {
    position: relative;
    display: grid;
    place-items: center;
    gap: var(--s-6);
    min-height: 92svh;
    padding: var(--s-9) var(--gutter);
    text-align: center;
    background: var(--ink);
    color: var(--bone);
    overflow: hidden;
  }

  .four__spot-line {
    position: relative;
    max-width: 20ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: var(--w-serif);
    font-size: var(--t-xl);
    line-height: 1.22;
    color: var(--bone-muted);
    text-wrap: balance;
  }
  .four__spot-line em { color: inherit; font-style: italic; }

  /* The bright duplicate, created by motion/present.js. */
  .four__spot :global(.spot__lit) {
    position: absolute;
    inset: 0;
    color: var(--tungsten);
    pointer-events: none;
    -webkit-mask-image: radial-gradient(circle var(--spot-r, 190px) at var(--spot-x, 50%) var(--spot-y, 50%), #000 0%, rgba(0,0,0,.55) 45%, transparent 72%);
    mask-image: radial-gradient(circle var(--spot-r, 190px) at var(--spot-x, 50%) var(--spot-y, 50%), #000 0%, rgba(0,0,0,.55) 45%, transparent 72%);
  }

  .four__spot-hint { color: var(--bone-muted); }

  /* --- mobile ----------------------------------------------------------------------- */
  @media (max-width: 48rem) {
    .four__card { padding: var(--s-5); min-height: 20rem; }
    .four__spot { min-height: 76svh; }
  }

  /* --- reduced motion ----------------------------------------------------------------
     The deck becomes five cards in a column. */
  :global(html[data-motion='reduced']) .four__deck-pin {
    min-height: 0;
    padding-block: var(--s-7);
  }
  :global(html[data-motion='reduced']) .four__deck {
    display: grid;
    gap: var(--s-5);
    width: min(48rem, 92vw);
  }
  :global(html[data-motion='reduced']) .four__card {
    grid-area: auto;
    opacity: 1 !important;
    transform: none !important;
    min-height: 0;
  }
  :global(html[data-motion='reduced']) .four__spot-hint { display: none; }
</style>
