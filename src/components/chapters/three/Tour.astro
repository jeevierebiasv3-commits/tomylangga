---
/**
 * Chapter III, movement four — the guided tour.
 *
 * Ten stops, each a short silent clip, moving through a dark theatre. The
 * writing that the old build hid in an aria-label is the point of this
 * movement, so it is set alongside each clip and reads as a caption.
 *
 * Clips are deferred: motion/memories.js attaches a source to a small window
 * around the active stop and detaches the rest, so there are never more than
 * a few decoders alive. The posters carry everything else.
 */
import Clip from '../../ui/Clip.astro';
import { STOPS } from '../../../data/tour.js';
---
<div class="tr" data-tour data-tone="dark">
  <div class="tr__pin" data-tour-pin>
    <div class="tr__glow" data-tour-glow aria-hidden="true"></div>

    <header class="tr__head">
      <p class="kicker tr__kicker">The guided tour</p>
      <p class="tr__progress mono" aria-hidden="true">
        <span data-tour-counter>01</span> / {String(STOPS.length).padStart(2, '0')}
      </p>
    </header>

    <ol class="tr__track" data-tour-track>
      {STOPS.map((s, i) => (
        <li class="tr__stop" data-tour-stop data-index={i}>
          <figure class="tr__figure">
            <div class="tr__screen">
              <Clip
                id={s.media}
                alt={s.alt}
                defer
                autoplay={false}
                loop
                preload="none"
              />
            </div>

            <figcaption class="tr__cap">
              <p class="tr__tag mono">
                <span class="tr__stop-n">Stop {s.id}</span>
                <span>{s.tag}</span>
              </p>
              <h4 class="tr__title">{s.title}</h4>
              <p class="tr__line">{s.line}</p>
              <p class="tr__note mono">{s.note}</p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ol>

    <div class="tr__rail" aria-hidden="true"><i data-tour-rail></i></div>
  </div>
</div>

<style>
  .tr {
    position: relative;
    background: #0A0908;
    color: var(--bone);
  }

  .tr__pin {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--s-5);
    padding: var(--s-8) var(--gutter) var(--s-7);
    overflow: hidden;
  }

  /* An ambient wash behind the active clip, tinted warm. Cheap stand-in for
     the canvas "ambilight" the old build repainted ten times a second. */
  .tr__glow {
    position: absolute;
    inset: 10% 20% 20%;
    background: radial-gradient(circle, rgba(232,176,122,.26), transparent 68%);
    filter: blur(80px);
    pointer-events: none;
    opacity: .7;
    transition: opacity var(--d-slow) var(--e-out);
  }

  .tr__head {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-5);
  }
  .tr__kicker { color: var(--bone-58); }
  .tr__progress { color: var(--bone-muted); font-variant-numeric: tabular-nums; }
  .tr__progress span { color: var(--tungsten); }

  /* --- the track ----------------------------------------------------------- */
  .tr__track {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    place-items: center;
  }

  /* Every stop shares one cell; the active one is brought forward. */
  .tr__stop {
    grid-area: 1 / 1;
    width: 100%;
    display: grid;
    place-items: center;
  }

  .tr__figure {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 20rem);
    gap: var(--s-7);
    align-items: center;
  }

  .tr__screen {
    overflow: hidden;
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-dark);
    background: #000;
  }

  .tr__cap { display: grid; gap: var(--s-3); }

  .tr__tag {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--bone-muted);
  }
  .tr__stop-n { color: var(--tungsten); }

  .tr__title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: var(--w-serif);
    font-size: var(--t-lg);
    line-height: 1.08;
    color: var(--bone);
  }

  .tr__line {
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--bone-78);
    max-width: 26ch;
  }

  .tr__note {
    font-size: 10px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--bone-muted);
  }

  /* --- the rail -------------------------------------------------------------- */
  .tr__rail {
    position: relative;
    z-index: 1;
    height: 1px;
    background: var(--bone-10);
  }
  .tr__rail i {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--tungsten);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* --- narrow ----------------------------------------------------------------- */
  @media (max-width: 64rem) {
    .tr__figure {
      grid-template-columns: 1fr;
      gap: var(--s-5);
      max-width: 26rem;
    }
    .tr__screen { max-height: 48svh; }
    .tr__screen :global(video) { max-height: 48svh; }
  }

  /* --- reduced motion -----------------------------------------------------------
     The theatre becomes a list of ten stops: poster, title, line. No pinning,
     no autoplay, and the controls are exposed so a clip plays only on request. */
  :global(html[data-motion='reduced']) .tr__pin {
    min-height: 0;
    display: block;
    overflow: visible;
    padding-block: var(--s-9);
  }
  :global(html[data-motion='reduced']) .tr__glow,
  :global(html[data-motion='reduced']) .tr__rail,
  :global(html[data-motion='reduced']) .tr__progress { display: none; }
  :global(html[data-motion='reduced']) .tr__track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--s-7);
    margin-top: var(--s-6);
    max-width: var(--maxw);
    margin-inline: auto;
  }
  :global(html[data-motion='reduced']) .tr__stop {
    grid-area: auto;
    opacity: 1 !important;
    transform: none !important;
  }
  :global(html[data-motion='reduced']) .tr__figure {
    grid-template-columns: 1fr;
    max-width: none;
  }
</style>
