---
/**
 * The memory map — every place this happened, in the order it happened.
 *
 * Two halves that stay in sync:
 *
 *   left   an ordered list of the milestones. This is the real content: full
 *          text, real dates in <time>, a thumbnail each. It reads perfectly
 *          on its own with no map, no script and no sight.
 *   right  a plotted route, drawn on as you scroll. Decorative, and marked
 *          aria-hidden — it repeats what the list already says.
 *
 * Scrolling the list moves the map; hovering or focusing an entry does too.
 * The map is never the only way to reach anything.
 */
import Picture from './ui/Picture.astro';
import { MILESTONES } from '../data/milestones.js';

/**
 * A smooth route through the plotted points (Catmull-Rom as cubic beziers).
 * The order is chronological, not geographic, so the line doubles back —
 * which is honest: they did too.
 */
function routePath(points, tension = 0.5) {
  if (points.length < 2) return '';
  const p = points;
  let d = `M ${p[0].x} ${p[0].y}`;
  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[i - 1] || p[i];
    const p1 = p[i];
    const p2 = p[i + 1];
    const p3 = p[i + 2] || p2;
    const c1x = p1.x + ((p2.x - p0.x) / 6) * tension * 2;
    const c1y = p1.y + ((p2.y - p0.y) / 6) * tension * 2;
    const c2x = p2.x - ((p3.x - p1.x) / 6) * tension * 2;
    const c2y = p2.y - ((p3.y - p1.y) / 6) * tension * 2;
    d += ` C ${c1x.toFixed(2)} ${c1y.toFixed(2)}, ${c2x.toFixed(2)} ${c2y.toFixed(2)}, ${p2.x} ${p2.y}`;
  }
  return d;
}

const route = routePath(MILESTONES);
---
<section class="map ch" id="memory-map" aria-labelledby="map-title" data-chapter="map">
  <div class="frame">
    <header class="ch__head">
      <p class="ch__eyebrow">
        <span class="ch__numeral">&mdash;</span>
        <span>Everywhere it happened</span>
      </p>
      <h2 class="ch__title" id="map-title" data-split>The map of us</h2>
      <p class="ch__lede">
        Eight places across Cebu, in the order they happened. The line doubles
        back on itself more than once, which is about right.
      </p>
    </header>
  </div>

  <div class="map__body frame">
    <!-- The plot. Everything it shows is in the list beside it. -->
    <div class="map__plot" aria-hidden="true">
      <div class="map__sticky" data-map-sticky>
        <svg class="map__svg" viewBox="0 0 100 110" fill="none" preserveAspectRatio="xMidYMid meet">
          <!-- faint contour, suggesting the west coast without claiming to be a survey -->
          <g class="map__contours">
            <path d="M 46 -6 C 30 14, 18 34, 14 56 C 10 78, 22 96, 44 108" />
            <path d="M 58 -6 C 42 16, 30 36, 26 58 C 22 80, 34 98, 56 110" />
            <path d="M 72 -4 C 58 18, 46 40, 42 62 C 38 84, 50 100, 70 112" />
          </g>

          <path class="map__route" d={route} pathLength="1" data-map-route />

          {MILESTONES.map((m, i) => (
            <g class="map__node" data-map-node={m.id} transform={`translate(${m.x} ${m.y})`}>
              <circle class="map__halo" r="5" />
              <circle class="map__dot" r="1.9" />
              <text class="map__num" x="0" y="-6.5" text-anchor="middle">
                {String(i + 1).padStart(2, '0')}
              </text>
            </g>
          ))}
        </svg>
      </div>
    </div>

    <!-- The content. -->
    <ol class="map__list">
      {MILESTONES.map((m, i) => (
        <li class="map__entry" data-map-entry={m.id}>
          <article class="map__card" tabindex="0" aria-labelledby={`ms-${m.id}`}>
            <p class="map__index mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>

            <div class="map__thumb">
              <Picture
                id={m.media}
                alt=""
                sizes="(max-width: 64rem) 20vw, 9rem"
                ratio="1 / 1"
              />
            </div>

            <div class="map__text">
              <h3 class="map__place" id={`ms-${m.id}`}>{m.place}</h3>
              <p class="map__meta mono">
                <span>{m.area}</span>
                {m.date
                  ? <time datetime={m.date}>{m.dateLabel}</time>
                  : m.dateLabel
                    ? <span>{m.dateLabel}</span>
                    : <span class="map__undated">date to confirm</span>}
              </p>
              <p class="map__title">{m.title}</p>
              <p class="map__line">{m.line}</p>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .map {
    background: var(--bone);
    padding-block: var(--s-8) var(--s-10);
  }

  .map__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--s-8);
    align-items: start;
  }

  /* --- the plot ------------------------------------------------------------ */
  .map__sticky {
    position: sticky;
    top: 12vh;
    padding-block: var(--s-5);
  }

  .map__svg {
    width: 100%;
    max-height: 72vh;
    overflow: visible;
  }

  .map__contours path {
    stroke: var(--ink-06);
    stroke-width: .5;
    fill: none;
  }

  .map__route {
    stroke: var(--ember);
    stroke-width: .6;
    stroke-linecap: round;
    stroke-dasharray: 2.4 2.4;
    fill: none;
    opacity: .85;
  }

  .map__node { transition: opacity var(--d-base) var(--e-out); }
  .map__halo {
    fill: var(--ember);
    opacity: 0;
    transition: opacity var(--d-base) var(--e-out),
                r var(--d-base) var(--e-snap);
  }
  .map__dot {
    fill: var(--bone);
    stroke: var(--ink-24);
    stroke-width: .5;
    transition: fill var(--d-base) var(--e-out), stroke var(--d-base) var(--e-out);
  }
  .map__num {
    font-family: var(--font-mono);
    font-size: 3px;
    fill: var(--ink-24);
    letter-spacing: .1em;
    transition: fill var(--d-base) var(--e-out);
  }

  .map__node[data-active='1'] .map__halo { opacity: .16; }
  .map__node[data-active='1'] .map__dot { fill: var(--ember); stroke: var(--ember); }
  .map__node[data-active='1'] .map__num { fill: var(--ember); }

  /* --- the list ------------------------------------------------------------- */
  .map__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .map__card {
    display: grid;
    grid-template-columns: 2.5rem 5.5rem minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
    padding: var(--s-5) var(--s-4);
    border-top: 1px solid var(--rule);
    border-radius: var(--r-sm);
    transition: background-color var(--d-base) var(--e-out);
  }
  .map__entry:last-child .map__card { border-bottom: 1px solid var(--rule); }

  .map__card:hover,
  .map__card:focus-visible,
  .map__entry[data-active='1'] .map__card {
    background: color-mix(in srgb, var(--bone-deep) 42%, transparent);
  }

  .map__index { color: var(--ink-muted); padding-top: .35em; }
  .map__entry[data-active='1'] .map__index { color: var(--ember-text); }

  .map__thumb {
    overflow: hidden;
    border-radius: var(--r-sm);
    filter: saturate(.7);
    transition: filter var(--d-base) var(--e-out);
  }
  .map__entry[data-active='1'] .map__thumb,
  .map__card:hover .map__thumb { filter: none; }

  .map__text { display: grid; gap: var(--s-2); }

  .map__place {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: var(--w-serif);
    font-size: var(--t-lg);
    line-height: 1.08;
  }

  .map__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  /* The one date nobody has been able to confirm — see data/milestones.js. */
  .map__undated { color: var(--ink-muted); font-style: italic; text-transform: none; letter-spacing: .04em; }

  .map__title {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
    color: var(--ember-text);
  }

  .map__line {
    font-size: var(--t-sm);
    line-height: 1.65;
    color: var(--ink-64);
    max-width: 44ch;
  }

  /* --- narrow ---------------------------------------------------------------- */
  @media (max-width: 64rem) {
    .map__body { grid-template-columns: 1fr; gap: var(--s-6); }
    /* The plot goes first and stays put while the list scrolls past it. */
    .map__plot { order: -1; }
    .map__sticky { top: 8vh; }
    .map__svg { max-height: 42svh; }
  }

  @media (max-width: 48rem) {
    .map__card {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: var(--s-3) var(--s-4);
    }
    .map__thumb { grid-column: 2; max-width: 7rem; }
    .map__text { grid-column: 2; }
  }
</style>
