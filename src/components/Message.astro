---
/**
 * The message — "Para sa akong langga".  A letter in fourteen small chapters.
 *
 * Ported from the "Night editorial (v2)" mockup in message-ref/. The mockup is
 * a standalone page with its own scroll root, preloader, topbar and cursor;
 * here it is one section of the story, so those are gone (the site already has
 * a progress bar, masthead and cursor) and the preloader becomes a curtain that
 * lifts off the opening spread the first time it is reached.
 *
 * Base styles are the finished state. Everything moving is added by
 * scripts/motion/message.js, and only when MOTION is enabled, so with reduced
 * motion — or no JavaScript — this is simply the letter, composed and complete.
 *
 * ScrollSmoother transforms the page, which disables `position: sticky`. The
 * sticky side columns, stacking cards and horizontal ride are therefore pinned
 * by ScrollTrigger in full motion, and fall back to native sticky / overflow
 * scrolling in reduced motion (when ScrollSmoother is not mounted).
 *
 * Split text is built here at render time rather than in the browser, with the
 * real sentence beside it in .sr-only so assistive tech reads it once.
 */
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import Picture from './ui/Picture.astro';
import {
  MSG_CHAPTERS, INK_TEXT, TYPED_LINE, STEADY, SORRY,
  MORE_A, MORE_B, THANKS, WAVE,
} from '../data/message.js';

/** Words → characters, with a running index for staggering. */
function chars(text: string, start = 0) {
  let k = start;
  const ws = text.split(' ');
  return ws.map((w, wi) => ({
    sp: wi < ws.length - 1 ? ' ' : '',
    cs: [...w].map((c) => ({ c, i: k++ })),
  }));
}

const hero1 = chars('Hi, my');
const hero2 = chars('langga.', 5);
const ink = INK_TEXT.split(' ');
const typed = chars(TYPED_LINE);
const buwakan = [...'Buwakan'];
const wave = [...WAVE];
const hearts = Array.from({ length: 17 }, (_, i) => i);
const HEART = 'M12 21s-7.5-4.6-9.6-9.2C.9 8.2 3 4.5 6.6 4.5c2.1 0 3.6 1.2 4.4 2.6.8-1.4 2.3-2.6 4.4-2.6 3.6 0 5.7 3.7 4.2 7.3C19.5 16.4 12 21 12 21z';
---
<section class="msg" id="the-letter" aria-labelledby="msg-title" data-tone="dark" data-msg>

  <!-- HERO · the opening spread ------------------------------------------ -->
  <div class="msg-hero" id="msg-top" data-msg-hero>
    <!-- The curtain: the mockup's preloader, lifted once on first arrival.
         Hidden unless motion/message.js shows it. -->
    <div class="msg-curtain" data-msg-curtain aria-hidden="true">
      <div class="msg-curtain__row"><span class="msg-mono">Para sa akong langga</span><span class="msg-mono">Usa ka sulat</span></div>
      <div class="msg-curtain__row msg-curtain__row--end">
        <span class="msg-disp msg-curtain__n" data-msg-count>0</span>
        <span class="msg-mono">Hinay-hinay lang og basa</span>
      </div>
    </div>

    <div class="msg-wrap msg-hero__top" data-msg-fade>
      <span class="msg-mono">Para sa akong langga</span>
      <span class="msg-mono msg-muted">Usa ka sulat · 14 ka kapitulo</span>
    </div>

    <h2 class="sr-only" id="msg-title">Hi, my langga.</h2>
    <div class="msg-disp msg-hero__type" aria-hidden="true">
      <div class="msg-wrap msg-hero__l1">
        <span>{hero1.map((w) => (<><span class="msg-wd">{w.cs.map((c) => <span class="msg-uch" style={`--i:${c.i}`}>{c.c}</span>)}</span>{w.sp}</>))}</span>
        <span class="msg-pill" data-msg-pill>
          <Picture id="moments/pic20" alt="" sizes="20rem" ratio="auto" class="msg-pill__pic" />
        </span>
      </div>
      <div class="msg-hero__l2" data-msg-l2>
        {hero2.map((w) => <span class="msg-wd">{w.cs.map((c) => <span class="msg-uch" style={`--i:${c.i}`}>{c.c}</span>)}</span>)}
      </div>
    </div>

    <div class="msg-wrap msg-hero__foot">
      <p class="msg-hero__lede" data-msg-fade>A letter in fourteen small chapters. Ang tanan nakong gusto isulti nimo, sa usa ka lugar.</p>
      <svg class="msg-spin" data-msg-fade data-msg-spin viewBox="0 0 160 160" width="140" height="140" role="img" aria-label="Hinay-hinay lang og basa">
        <defs><path id="msg-circ" d="M 80,80 m -62,0 a 62,62 0 1,1 124,0 a 62,62 0 1,1 -124,0" /></defs>
        <text class="msg-spin__text"><textPath href="#msg-circ">Hinay-hinay lang og basa · para sa akong langga · </textPath></text>
        <path d="M80 96s-12-7.4-15.4-14.7C62.2 75.6 65.6 69.6 71.4 69.6c3.4 0 5.8 1.9 7 4.2 1.3-2.3 3.7-4.2 7.1-4.2 5.8 0 9.1 6 6.7 11.7C89.8 88.6 80 96 80 96z" class="msg-rose-fill" />
      </svg>
    </div>
  </div>

  <!-- INDEX --------------------------------------------------------------- -->
  <div class="msg-index" data-msg-indexwrap>
    <div class="msg-wrap">
      <div class="msg-chh msg-chh--tight"><span class="msg-mono msg-rose">Mga kapitulo</span><span class="msg-mono msg-muted">14</span></div>
      <nav aria-label="Chapters of the letter" data-msg-index>
        {MSG_CHAPTERS.map((c) => (
          <a class="msg-row" href={`#${c.id}`} data-msg-row data-media={c.media ?? ''}>
            <span class="msg-mono msg-rose" data-msg-rown>{c.n}</span>
            <span class="msg-row__t">{c.t}</span>
            <span class="msg-row__ar" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </nav>
      {/* Hover previews. Pointer-only decoration; motion/message.js drives it. */}
      <div class="msg-preview" aria-hidden="true" data-msg-preview>
        {MSG_CHAPTERS.filter((c) => c.media).map((c) => (
          <div class="msg-preview__img" data-msg-prev={c.media}>
            <Picture id={c.media!} alt="" sizes="18rem" ratio="4 / 5" />
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 01 · Ink ------------------------------------------------------------ -->
  <div id="msg-c1" class="msg-ch">
    <div class="msg-wrap msg-grid" data-msg-grid>
      <aside class="msg-side"><div class="msg-stick" data-msg-stick><span class="msg-num" aria-hidden="true">01</span><span class="msg-mono msg-rose">Ka-lucky</span></div></aside>
      <div class="msg-main">
        <p class="msg-disp msg-ink" data-msg-ink>
          <span class="sr-only">{INK_TEXT}</span>
          <span aria-hidden="true">{ink.map((w, i) => <span class="msg-w">{w}{i < ink.length - 1 ? ' ' : ''}</span>)}</span>
        </p>
      </div>
    </div>
  </div>

  <!-- 02 · Ghost to solid + photo pair ------------------------------------ -->
  <div id="msg-c2" class="msg-ch">
    <div class="msg-wrap msg-grid" data-msg-grid>
      <aside class="msg-side"><div class="msg-stick" data-msg-stick><span class="msg-num" aria-hidden="true">02</span><span class="msg-mono msg-rose">Sauna ug karon</span></div></aside>
      <div class="msg-main msg-gap-80">
        <div class="msg-disp msg-c2-head">
          <span class="msg-ghost" data-msg-ghost>Ang mga butang nga ato rang gipangandoy sauna,</span>
          <span class="msg-rose msg-block" data-msg-rv>nahitabo na diay sa atoang duha.</span>
        </div>
        <div class="msg-pair">
          <figure class="msg-fig" data-msg-clip>
            <div class="msg-ph"><Picture id="moments/pic12" alt="The two of them at the Toledo City fiesta, the night of their first date." sizes="(max-width: 54rem) 92vw, 30vw" ratio="4 / 5" /></div>
            <figcaption class="msg-mono msg-muted">Sauna · gipangandoy ra</figcaption>
          </figure>
          <figure class="msg-fig msg-fig--drop" data-msg-clip>
            <div class="msg-ph"><Picture id="moments/pic26" alt="A slow afternoon together at home." sizes="(max-width: 54rem) 92vw, 30vw" ratio="4 / 5" /></div>
            <figcaption class="msg-mono msg-rose">Karon · nahitabo na</figcaption>
          </figure>
        </div>
        <p class="msg-p" data-msg-rv>Langga, happy kaayo ko sa atong relationship, especially when I look back at how we started and compare it to where we are now. Sauna, naa pa tay mga butang nga gipangandoy lang nato. There were places we wanted to go to, dates we wanted to experience, and memories we wished we could make together. Karon, slowly, we're finally experiencing those things together. And honestly, one of the best feelings in the world is realizing nga ang mga butang nga ato rang gipangandoy sauna, nahitabo na diay sa atoang duha.</p>
      </div>
    </div>
  </div>

  <!-- 03 · Line mask + marker --------------------------------------------- -->
  <div id="msg-c3" class="msg-ch">
    <div class="msg-wrap msg-grid" data-msg-grid>
      <aside class="msg-side"><div class="msg-stick" data-msg-stick><span class="msg-num" aria-hidden="true">03</span><span class="msg-mono msg-rose">Kung moanhi ka</span></div></aside>
      <div class="msg-main">
        <h3 class="msg-disp msg-c3-head"><span class="msg-lm"><span>I can feel your love</span></span><span class="msg-lm"><span class="msg-it msg-rose">in the way you stay.</span></span></h3>
        <p class="msg-p" data-msg-rv>I love it when you come here sa among house and mag-overnight ka. I love how we get to spend more time together now compared sauna. Mas dugay na ta mag-uban, mas daghan na ta og moments nga ato ra, and I can really feel nga mas attached na pud ka nako. I can feel your love in the way you stay, in the way you spend your time with me, and in the way you make me feel nga <mark class="msg-sw">you genuinely want to be here with me.</mark></p>
        <p class="msg-p" data-msg-rv>And langga, I hope you know nga I appreciate all of that so much. <mark class="msg-sw">I feel so loved by you.</mark> Dili lang tungod sa imong words, but because of <mark class="msg-sw">the time and effort you give me.</mark> You make me feel nga I'm someone you genuinely want to be with, and that means so much to me.</p>
      </div>
    </div>
  </div>

  <!-- 04 · Typewriter ----------------------------------------------------- -->
  <div id="msg-c4" class="msg-ch">
    <div class="msg-wrap msg-grid" data-msg-grid>
      <aside class="msg-side"><div class="msg-stick" data-msg-stick><span class="msg-num" aria-hidden="true">04</span><span class="msg-mono msg-rose">Sa atong room</span></div></aside>
      <div class="msg-main">
        <p class="msg-p" data-msg-rv>Ganahan kaayo ko anang mga moments nga naa ra ta sa atong room, magkatawa sa mga random nga butang, maghamag-hamag, magstorya og bisan unsa, or maglingaw-lingaw lang ta nga kitang duha. Sometimes, we're not even doing anything special, pero happy kaayo ko. Wala tay kinahanglan adtoan, wala tay kinahanglan paliton, and we don't need to do anything grand. Basta naa ka sa akong tapad, okay na kaayo ko. Those are the moments nga makaingon ko sa akong self,</p>
        <blockquote class="msg-disp msg-tw" data-msg-tw>
          <span class="sr-only">{TYPED_LINE}</span>
          <span aria-hidden="true">{typed.map((w) => (<><span class="msg-wd">{w.cs.map((c) => <span class="msg-ch1">{c.c}</span>)}</span>{w.sp}</>))}<span class="msg-caret" data-msg-caret></span></span>
        </blockquote>
        <p class="msg-p" data-msg-rv>You're not just my girlfriend, langga. You're also someone nga I can laugh with, be silly with, and just be myself around.</p>
      </div>
    </div>
  </div>

  <!-- 05 · Pinned horizontal ride ----------------------------------------- -->
  <div id="msg-c5" class="msg-c5">
    <div class="msg-wrap"><div class="msg-chh"><span class="msg-chh__l"><span class="msg-num" aria-hidden="true">05</span><span class="msg-mono msg-rose">Hinay-hinay</span></span><span class="msg-mono msg-muted">Scroll · mag-laag ta</span></div></div>
    <div class="msg-hview" data-msg-hview>
      <div class="msg-htrack" data-msg-htrack>
        <div class="msg-hcard" style="--w:min(560px,80vw)"><span class="msg-mono msg-muted">Sauna</span><p class="msg-disp msg-h-36">Remember those places nga ato rang gipangandoy sauna kay <em class="msg-rose">wala pa tay motor?</em></p></div>
        <div class="msg-hph" style="--w:min(420px,70vw);--h:min(560px,62vh)" data-msg-hph><Picture id="ice/ice-07" alt="A selfie together in the dark of a cinema, settled into purple seats." sizes="420px" ratio="auto" /></div>
        <div class="msg-hcard" style="--w:min(520px,80vw)"><span class="msg-mono msg-rose">Karon</span><p class="msg-disp msg-h-44 msg-it">Nakaadto na gyud ta sa uban.</p></div>
        <div class="msg-hph msg-hph--low" style="--w:min(360px,70vw);--h:min(460px,52vh)" data-msg-hph><Picture id="buwakan/buwakan-19" alt="Standing together on a garden path under arches of leaves and flowers at Buwakan." sizes="360px" ratio="auto" /></div>
        <div class="msg-hcard" style="--w:min(600px,80vw)"><p class="msg-disp msg-h-32">Kanang mag-date ta sa syudad, maglaag ta nga wala kaayo tay paki kung naay makakita nato.</p></div>
        <div class="msg-hph" style="--w:min(460px,70vw);--h:min(600px,66vh)" data-msg-hph><Picture id="ice/ice-08" alt="Their feet side by side in rental skates, lacing up at the rink." sizes="460px" ratio="auto" /></div>
        <div class="msg-hcard msg-hcard--last" style="--w:min(820px,86vw)"><p class="msg-disp msg-h-52 msg-it msg-rose">Hinay-hinay, nahimo na gyud silang memories.</p></div>
      </div>
      <div class="msg-wrap msg-hbar" aria-hidden="true">
        <span class="msg-mono msg-muted">Sauna</span>
        <span class="msg-hbar__rail"><i data-msg-hbar></i></span>
        <span class="msg-mono msg-rose">Karon</span>
      </div>
    </div>
    <div class="msg-wrap msg-c5-after">
      <div class="msg-indent">
        <p class="msg-p" data-msg-rv>And our dates, langga. Grabe, if I think about them, maka-smile gyud ko. Remember those places nga ato rang gipangandoy sauna kay wala pa tay motor? Karon, nakaadto na gyud ta sa uban. We finally got to explore places together, especially sa city, and I was so happy nga kita ang mag-uban.</p>
        <p class="msg-p" data-msg-rv>Kanang mag-date ta sa syudad, maglaag ta nga wala kaayo tay paki kung naay makakita nato, kay we're just enjoying our time together. I love those moments because I get to experience life with you. It feels so good nga dili na lang nato imagination ang atong mga plans, kay hinay-hinay, nahimo na gyud silang memories.</p>
      </div>
    </div>
  </div>

  <!-- 06 · Glide + trails + ice triptych ---------------------------------- -->
  <div id="msg-c6" class="msg-ch">
    <div class="msg-wrap"><div class="msg-chh msg-chh--tight"><span class="msg-chh__l"><span class="msg-num" aria-hidden="true">06</span><span class="msg-mono msg-rose">Ice skating</span></span><span class="msg-mono msg-muted">Usa sa dili malimtan</span></div></div>
    <h3 class="msg-disp msg-buwakan" data-msg-glide>
      <span class="sr-only">Buwakan</span>
      <span aria-hidden="true">{buwakan.map((c) => <span class="msg-gl">{c}</span>)}</span>
    </h3>
    <svg class="msg-trails" aria-hidden="true" viewBox="0 0 1200 160" preserveAspectRatio="none" data-msg-trails>
      <path class="msg-trail" pathLength="1" d="M-10 120 C 180 20, 320 150, 520 84 S 820 6, 920 92 S 1110 150, 1210 36" fill="none" stroke="var(--m-ice)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
      <path class="msg-trail" pathLength="1" d="M-10 98 C 200 40, 300 160, 540 96 S 800 26, 940 104 S 1100 128, 1210 58" fill="none" stroke="var(--m-rose)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
    </svg>
    <div class="msg-wrap">
      <div class="msg-tri" data-msg-clip>
        <div class="msg-ph"><Picture id="buwakan/buwakan-19" alt="Standing together on a garden path under arches of leaves and flowers at Buwakan." sizes="(max-width: 54rem) 92vw, 30vw" ratio="3 / 4" /></div>
        <div class="msg-ph msg-tri__mid"><Picture id="buwakan/buwakan-21" alt="A kiss on the cheek in a selfie, flowers and green mountains behind them." sizes="(max-width: 54rem) 92vw, 30vw" ratio="3 / 4" /></div>
        <div class="msg-ph"><Picture id="buwakan/buwakan-22" alt="Sitting together on a rock among hydrangeas and pink and white blooms." sizes="(max-width: 54rem) 92vw, 30vw" ratio="3 / 4" /></div>
      </div>
      <div class="msg-split">
        <p class="msg-disp msg-c6-lines"><span class="msg-lm"><span>Not necessarily because</span></span><span class="msg-lm"><span>of the place itself,</span></span><span class="msg-lm"><span class="msg-it msg-ice">but because ikaw</span></span><span class="msg-lm"><span class="msg-it msg-ice">akong kauban.</span></span></p>
        <div class="msg-col">
          <p class="msg-p" data-msg-rv>And langga, our date sa Buwakan sa Ice Skating! Grabe, nindot kaayo to nga experience. One of those dates nga dili gyud dali malimtan. Happy kaayo ko ato, and if I could go back to that moment, I would. Not necessarily because of the place itself, but because ikaw akong kauban.</p>
          <p class="msg-p" data-msg-rv>The place was beautiful, but having you there made the experience even more special. I love that we now have memories nga pwede nato balikan and storyahan in the future. Mga moments nga puhon, makatawa na lang ta while remembering how happy we were. And I hope daghan pa kaayo tag ing-ana nga experiences together.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- 07 · Steady + focus ------------------------------------------------- -->
  <div id="msg-c7" class="msg-ch">
    <div class="msg-wrap msg-grid" data-msg-grid>
      <aside class="msg-side"><div class="msg-stick" data-msg-stick><span class="msg-num" aria-hidden="true">07</span><span class="msg-mono msg-rose">Bisan pa sa away</span></div></aside>
      <div class="msg-main msg-gap-72">
        <div class="msg-c7-row">
          <div class="msg-steady" data-msg-steady>
            {STEADY.map((s) => <span class="msg-disp msg-st">{s}</span>)}
          </div>
          <p class="msg-disp msg-focus msg-c7-focus" data-msg-focus>But when I think about everything we've shared, I know nga <span class="msg-rose">worth it kaayo nga paningkamotan nato ni.</span></p>
        </div>
        <p class="msg-p" data-msg-rv>Mao bitaw, langga, despite sa atong mga away, dili nako kalimtan ang tanan natong happy moments. Dili nako gusto nga tungod lang sa mga times nga dili ta magkasinabot, makalimtan nato kung unsa ka nindot ang atong relationship and how much love we have for each other. I know nga dili permi happy ang tanan. Naa gyud tay times nga maglalis, masuko, maghilom, and maghilak. But when I think about everything we've shared, I know nga worth it kaayo nga paningkamotan nato ni.</p>
      </div>
    </div>
  </div>

  <!-- 08 · Fill + stacking cards ------------------------------------------ -->
  <div id="msg-c8" class="msg-ch msg-c8" data-msg-aperture>
    <div class="msg-wrap">
      <div class="msg-chh"><span class="msg-chh__l"><span class="msg-num" aria-hidden="true">08</span><span class="msg-mono msg-rose">Pasayloa ko</span></span><span class="msg-mono msg-muted">Tulo ka pasaylo</span></div>
      <h3 class="msg-disp msg-fillx" data-msg-fillx>Sorry, langga.</h3>
      <div class="msg-stacks" data-msg-stacks>
        {SORRY.map((s, i) => (
          <article class="msg-stack" style={`--top:${110 + i * 30}px`} data-msg-stack>
            <span class="msg-mono msg-rose">{s.tag}</span>
            <p class="msg-p msg-p--lg">{s.body}</p>
          </article>
        ))}
      </div>
      <p class="msg-disp msg-c8-close" data-msg-rv>You deserve to be <mark class="msg-sw">heard,</mark> <mark class="msg-sw">understood,</mark> and <mark class="msg-sw">comforted,</mark> <em class="msg-muted">even when we're not okay with each other.</em></p>
    </div>
  </div>

  <!-- 09 · Focus ---------------------------------------------------------- -->
  <div id="msg-c9" class="msg-ch">
    <div class="msg-wrap msg-grid" data-msg-grid>
      <aside class="msg-side"><div class="msg-stick" data-msg-stick><span class="msg-num" aria-hidden="true">09</span><span class="msg-mono msg-rose">Sa lisod pud</span></div></aside>
      <div class="msg-main msg-gap-72">
        <p class="msg-disp msg-focus msg-c9-head" data-msg-focus>I don't just want to have you during our happy moments. <em class="msg-rose">I also want to be there for you during the difficult ones.</em></p>
        <p class="msg-p" data-msg-rv>Kay langga, I don't just want to have you during our happy moments. I also want to be there for you during the difficult ones. I want to learn how to love you better, especially when things get complicated between us. Dili lang kay kabalo ko magpakatawa nimo or mag-date ta sa mga nindot nga lugar, but also because I want you to feel nga you can count on me when you're hurting. I know nga actions matter more than promises, and I want to show you that I'm willing to work on myself for us.</p>
      </div>
    </div>
  </div>

  <!-- 10 · Line mask ------------------------------------------------------ -->
  <div id="msg-c10" class="msg-ch">
    <div class="msg-wrap msg-grid" data-msg-grid>
      <aside class="msg-side"><div class="msg-stick" data-msg-stick><span class="msg-num" aria-hidden="true">10</span><span class="msg-mono msg-rose">Namatikdan nako</span></div></aside>
      <div class="msg-main msg-gap-64">
        <p class="msg-disp msg-c10-head"><span class="msg-lm"><span>I feel it,</span></span><span class="msg-lm"><span class="msg-rose">langga.</span></span></p>
        <p class="msg-p" data-msg-rv>And please know nga I notice the love you give me. I notice how much time you spend with me now, how you come here, how we get to be together longer, and how close we've become. I feel it, langga. I feel nga love kaayo ko nimo, and I hope I make you feel loved, too.</p>
        <p class="msg-p" data-msg-rv>I hope you never feel nga I take your presence for granted because I really don't. Having you here, being able to hug you, laugh with you, and spend time with you is something I genuinely treasure.</p>
      </div>
    </div>
  </div>

  <!-- 11 · Marquee -------------------------------------------------------- -->
  <div id="msg-c11" class="msg-ch">
    <div class="msg-wrap msg-grid msg-mb-110" data-msg-grid>
      <aside class="msg-side"><div class="msg-stick" data-msg-stick><span class="msg-num" aria-hidden="true">11</span><span class="msg-mono msg-rose">Daghan pa</span></div></aside>
      <div class="msg-main">
        <p class="msg-p" data-msg-rv>If there's one thing I wish for us, it's that we never lose the happiness we find in the simplest things. I hope even when we're older, we'll still enjoy spending time together, laughing at random things, going on dates, discovering new places, and remembering all the little adventures we had when we were younger. I hope we can keep making memories and looking back at how far we've come, from the days nga mag-imagine ra ta sa mga places nga atoang adtoan, to the days nga naa na gyud ta didto together.</p>
      </div>
    </div>
    <div class="msg-band" aria-hidden="true" data-msg-skew>
      <div class="msg-band__row"><div class="msg-mq" data-msg-mq>
        {[...MORE_A, ...MORE_A].map((m) => (
          <span class="msg-disp msg-mq__item msg-it">{m}<svg viewBox="0 0 24 24" width="30" height="30" class="msg-rose-fill"><path d={HEART} /></svg></span>
        ))}
